using UnityEngine;
using System.Collections.Generic;

public class GameManager : MonoBehaviour
{
    public static GameManager Instance;

    [Header("Economy")]
    public int money = 50000;

    [Header("Prison")]
    public int prisonerCount;
    public int guardCount;

    [Header("Power")]
    public int totalPower = 1000;
    public int usedPower = 0;

    [Header("Water")]
    public int totalWater = 1000;
    public int usedWater = 0;

    [Header("Riot")]
    public int dangerLevel = 0;
    public bool riotActive = false;

    void Awake()
    {
        if (Instance == null)
        {
            Instance = this;
            DontDestroyOnLoad(gameObject);
        }

        Application.targetFrameRate = 60;
        QualitySettings.vSyncCount = 0;
        Screen.sleepTimeout = SleepTimeout.NeverSleep;
    }

    void Update()
    {
        if (dangerLevel >= 75 && !riotActive)
        {
            StartRiot();
        }
    }

    void StartRiot()
    {
        riotActive = true;
        Debug.Log("RIOT STARTED");
    }

    public void AddMoney(int amount)
    {
        money += amount;
    }

    public bool SpendMoney(int amount)
    {
        if (money >= amount)
        {
            money -= amount;
            return true;
        }

        return false;
    }

    public bool HasPower(int amount)
    {
        return usedPower + amount <= totalPower;
    }

    public bool HasWater(int amount)
    {
        return usedWater + amount <= totalWater;
    }
}

public class GridManager : MonoBehaviour
{
    public static GridManager Instance;

    public int width = 100;
    public int height = 100;
    public float cellSize = 1f;

    void Awake()
    {
        Instance = this;
    }

    public Vector3 GetWorldPosition(int x, int y)
    {
        return new Vector3(x, y) * cellSize;
    }

    public Vector2Int GetGridPosition(Vector3 worldPosition)
    {
        int x = Mathf.FloorToInt(worldPosition.x / cellSize);
        int y = Mathf.FloorToInt(worldPosition.y / cellSize);

        return new Vector2Int(x, y);
    }
}

public class CameraController : MonoBehaviour
{
    private Vector3 touchStart;

    public float zoomOutMin = 5;
    public float zoomOutMax = 20;

    void Update()
    {
        if (Input.touchCount == 1)
        {
            Touch touch = Input.GetTouch(0);

            if (touch.phase == TouchPhase.Began)
            {
                touchStart =
                    Camera.main.ScreenToWorldPoint(touch.position);
            }

            if (touch.phase == TouchPhase.Moved)
            {
                Vector3 direction =
                    touchStart -
                    Camera.main.ScreenToWorldPoint(touch.position);

                Camera.main.transform.position += direction;
            }
        }

        if (Input.touchCount == 2)
        {
            Touch touchZero = Input.GetTouch(0);
            Touch touchOne = Input.GetTouch(1);

            Vector2 touchZeroPrev =
                touchZero.position - touchZero.deltaPosition;

            Vector2 touchOnePrev =
                touchOne.position - touchOne.deltaPosition;

            float prevMagnitude =
                (touchZeroPrev - touchOnePrev).magnitude;

            float currentMagnitude =
                (touchZero.position - touchOne.position).magnitude;

            float difference =
                currentMagnitude - prevMagnitude;

            Zoom(difference * 0.01f);
        }
    }

    void Zoom(float increment)
    {
        Camera.main.orthographicSize =
            Mathf.Clamp(
                Camera.main.orthographicSize - increment,
                zoomOutMin,
                zoomOutMax
            );
    }
}

public class BuildingSystem : MonoBehaviour
{
    public GameObject wallPrefab;
    public GameObject doorPrefab;

    void Update()
    {
        if (Input.GetMouseButtonDown(0))
        {
            PlaceObject(wallPrefab);
        }

        if (Input.GetMouseButtonDown(1))
        {
            PlaceObject(doorPrefab);
        }
    }

    void PlaceObject(GameObject prefab)
    {
        Vector3 mouseWorld =
            Camera.main.ScreenToWorldPoint(Input.mousePosition);

        mouseWorld.z = 0;

        Vector3 snappedPosition =
            new Vector3(
                Mathf.Round(mouseWorld.x),
                Mathf.Round(mouseWorld.y),
                0
            );

        Instantiate(
            prefab,
            snappedPosition,
            Quaternion.identity
        );
    }
}

public class PrisonerAI : MonoBehaviour
{
    public float moveSpeed = 2f;

    public int health = 100;
    public int anger = 0;
    public int intelligence = 50;

    public float hunger = 100;
    public float sleep = 100;
    public float hygiene = 100;
    public float freedom = 100;

    private Vector3 target;

    void Start()
    {
        PickNewTarget();
    }

    void Update()
    {
        transform.position =
            Vector3.MoveTowards(
                transform.position,
                target,
                moveSpeed * Time.deltaTime
            );

        hunger -= Time.deltaTime;
        sleep -= Time.deltaTime * 0.5f;
        hygiene -= Time.deltaTime * 0.2f;
        freedom -= Time.deltaTime * 0.1f;

        if (Vector3.Distance(transform.position, target) < 0.1f)
        {
            PickNewTarget();
        }

        if (hunger < 20 || sleep < 20)
        {
            anger += 1;
        }

        if (anger > 50)
        {
            GameManager.Instance.dangerLevel += 1;
        }
    }

    void PickNewTarget()
    {
        target =
            new Vector3(
                Random.Range(0, 50),
                Random.Range(0, 50),
                0
            );
    }
}

public class GuardAI : MonoBehaviour
{
    public Transform targetPrisoner;
    public float speed = 3f;

    void Update()
    {
        if (targetPrisoner == null)
            return;

        transform.position =
            Vector3.MoveTowards(
                transform.position,
                targetPrisoner.position,
                speed * Time.deltaTime
            );
    }
}

public class DoorController : MonoBehaviour
{
    public bool isOpen = false;

    public void ToggleDoor()
    {
        isOpen = !isOpen;

        if (isOpen)
        {
            transform.rotation =
                Quaternion.Euler(0, 0, 90);
        }
        else
        {
            transform.rotation =
                Quaternion.identity;
        }
    }
}

