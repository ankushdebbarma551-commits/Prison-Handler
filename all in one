public class SaveSystem : MonoBehaviour
{
    public void SaveGame()
    {
        PlayerPrefs.SetInt(
            "Money",
            GameManager.Instance.money
        );

        PlayerPrefs.SetInt(
            "Danger",
            GameManager.Instance.dangerLevel
        );

        PlayerPrefs.Save();
    }

    public void LoadGame()
    {
        GameManager.Instance.money =
            PlayerPrefs.GetInt("Money", 50000);

        GameManager.Instance.dangerLevel =
            PlayerPrefs.GetInt("Danger", 0);
    }
}

